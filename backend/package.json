{
  "name": "decidix-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Decidix Smart National Development Decision Support System - Independent Backend API",
  "main": "dist/server.js",
  "scripts": {
    "build": "prisma generate && tsc && node -e \"import('fs').then(fs => { import('path').then(path => { const src='src/database/migrations'; const dst='dist/database/migrations'; if(fs.existsSync(src)){fs.mkdirSync(dst,{recursive:true}); fs.readdirSync(src).forEach(f=>fs.copyFileSync(path.join(src,f),path.join(dst,f)));} }); })\"",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/database/migrate.ts",
    "seed": "tsx src/database/seed.ts",
    "forecast:import": "tsx src/database/seed_forecasts.ts",
    "rag:ingest": "tsx src/database/ingest_rag_documents.ts",
    "r2:verify": "tsx src/scripts/verify-r2.ts",
    "dataset:bootstrap": "tsx src/scripts/bootstrap-dataset.ts",
    "forecast:generate": "tsx src/scripts/generate-forecasts.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.3",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.3.1",
    "pg": "^8.13.3",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
